<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="116dp"
    android:layout_height="188dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#101218"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- التقييم الفوق على اليمين بالذهبي وبطبقة داكنة وراه -->
        <TextView
            android:id="@+id/tvVodMeta"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rating_pill_dark"
            android:drawableStart="@drawable/ic_star_gold"
            android:drawablePadding="3dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingHorizontal="6.5dp"
            android:text="8.5"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- طبقة التدرج الأسود الفايد -->
        <View
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_bottom_fade" />

        <!-- اسم الفيلم أو المسلسل تحت قاع فالكارت بخط مختلف وأصغر شوية -->
        <TextView
            android:id="@+id/tvVodTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp"
            android:shadowColor="#DD000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Movie Title"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:textStyle="bold" />

    </FrameLayout>
</androidx.cardview.widget.CardView>