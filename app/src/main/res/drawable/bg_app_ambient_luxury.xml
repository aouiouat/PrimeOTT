<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الطبقة الأساسية السوداء -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- تدرج Ambient علوي وجانبي بنفس لون FlixVision القياسي (#233242 -> #000000) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#121A24"
                android:endColor="#000000"
                android:startColor="#233242"
                android:type="linear" />
        </shape>
    </item>
</layer-list>