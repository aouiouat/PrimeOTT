<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الطبقة الأساسية: أسود ملكي زجاجي داكن جدا -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F50B0C10"
                android:centerColor="#F8060709"
                android:endColor="#FA030305"
                android:type="linear" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>

    <!-- لمعة الزجاج العلوية الفخمة (Top Glass Specular Highlight) -->
    <item
        android:bottom="32dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp" />
        </shape>
    </item>
</layer-list>