<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:layoutDirection="ltr"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="95dp">

        <!-- 1. Top Header: PRIME [►] OTT + Search Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIME"
                android:textColor="#E50914"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="5dp"
                android:background="#E50914"
                android:gravity="center"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OTT"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnHomeSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/abc_ic_search_api_material"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 2. 3D Auto-Sliding Hero Banner Carousel (يتبدل كل 5 ثواني تلقائياً) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroViewPager"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="42dp" />

        <!-- 3. Watch Now Red Pill Button + Favorite Square Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWatchFeatured"
                android:layout_width="175dp"
                android:layout_height="50dp"
                android:backgroundTint="#D91921"
                android:text="▶  Watch Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHeroFavorite"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_search_box_dark"
                android:gravity="center"
                android:text="♡"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 4. Recent Section + Clear Watch History -->
        <LinearLayout
            android:id="@+id/recentHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRecentHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ Clear Watch History"
                android:textColor="#E50914"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentWatched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

        <!-- 5. Trending Today Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trending Today"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeeAllMovies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="#E50914"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeChannels"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp" />

        <!-- 6. Trending TV Series Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trending Series"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeeAllSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="#E50914"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeSeries"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp" />

    </LinearLayout>
</ScrollView>