<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#38E50914" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#99FF2A36" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#1AE50914"
                android:startColor="#29E50914"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="0.9dp"
                android:color="#55FF2A36" />
        </shape>
    </item>
</selector>