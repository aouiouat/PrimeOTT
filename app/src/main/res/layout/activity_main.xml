<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:layoutDirection="ltr">

    <!-- Container ta3 Les Fragments -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Luxury Black Glass Floating Bottom Bar -->
    <FrameLayout
        android:id="@+id/floatingBottomBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_floating_nav_pill"
        android:elevation="22dp"
        android:layoutDirection="ltr"
        android:paddingHorizontal="6dp">

        <!-- Focus Capsule (3rida chwiy 56x44dp b Red Glass) -->
        <FrameLayout
            android:id="@+id/liveTvCircleBg"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|left"
            android:background="@drawable/bg_nav_tv_active_circle" />

        <!-- Les 6 Tabs b 7ajm wadh7 26dp -->
        <LinearLayout
            android:id="@+id/navTabsRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:weightSum="6">

            <FrameLayout
                android:id="@+id/navTabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_home" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTabMovies"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavMovies"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_movies" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTabSeries"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavSeries"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_series" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTabLive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavLive"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_live_tv" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTabMatches"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavMatches"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_events" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTabWatch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivNavProfile"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_profile" />
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>