<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B11"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="18dp">

        <!-- زر العودة لتسجيل الدخول -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTopBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/auth_btn_guest"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="↩ Back to Login • العودة للدخول"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="👑 ROYAL TV"
            android:textColor="#E50914"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CREATE NEW ACCOUNT — إنشاء حساب جديد"
            android:textColor="#9AA5B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegMessageBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_bg_card"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- قسم الصورة الشخصية (Profile Picture) -->
        <FrameLayout
            android:id="@+id/flProfilePictureContainer"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/auth_avatar_circle">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/tvEmojiAvatarOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="👑"
                android:textSize="38sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUploadProfilePic"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/auth_btn_guest"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="📷 اختيار صورة / أفاتار"
                android:textColor="#80D8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRemoveProfilePic"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/auth_btn_guest"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🗑️ حذف الصورة"
                android:textColor="#FF8A80"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- بطاقة بيانات الحساب الجديد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/auth_bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etRegFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_bg_input"
                android:hint="📝 الاسم الكامل (Full Name)"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etRegUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_bg_input"
                android:hint="👤 اسم المستخدم (Username)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etRegEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_bg_input"
                android:hint="✉️ البريد الإلكتروني (Email Address)"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="🔒 كلمة المرور (Password)"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnToggleRegPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="إظهار 👁️"
                    android:textColor="#80D8FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etRegConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_bg_input"
                android:hint="🔒 تأكيد كلمة المرور (Confirm Password)"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbAgreeTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="#E50914"
                android:text="أوافق على الشروط والأحكام (I agree to Terms &amp; Conditions)"
                android:textColor="#D0D7E2"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreateAccountSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/auth_btn_primary"
                android:text="إنشاء الحساب • Create Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_btn_google"
            android:text="🌐 التسجيل السريع باستخدام حساب Google"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لديك حساب بالفعل؟ "
                android:textColor="#9AA5B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAlreadyHaveAccountLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تسجيل الدخول • Login"
                android:textColor="#80D8FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>