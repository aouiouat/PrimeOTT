<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layoutDirection="ltr"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="90dp">

        <!-- 1. Top Header: REYZO [Play] TV + Search Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/product_sans_bold"
                android:letterSpacing="0.03"
                android:text="REYZO"
                android:textColor="#E50914"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_btn_play_white_luxury">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_watch_now"
                    app:tint="#16181E" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/product_sans_bold"
                android:letterSpacing="0.03"
                android:text="TV"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/btnHomeSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/search_bg"
                android:padding="9dp"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <!-- 2. Smooth Hero Banner Carousel (مطابق لأبعاد وسلاسة الفيديو: أطول شوية 382dp وأرق 62dp) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroViewPager"
            android:layout_width="match_parent"
            android:layout_height="382dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="62dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <!-- 3. Watch Now Button + Glass Favorite Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnWatchFeatured"
                android:layout_width="184dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_play_white_luxury"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play_watch_now"
                    app:tint="#16181E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/product_sans_bold"
                    android:letterSpacing="0.02"
                    android:text="Watch Now"
                    android:textColor="#16181E"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHeroFavorite"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_favorite_glass"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_heart_outline" />
        </LinearLayout>

        <!-- 4. Continue Watching Section -->
        <LinearLayout
            android:id="@+id/recentHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRecentHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="Continue Watching"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClearHistory"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="3dp"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentWatched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

        <!-- 5. Trending Today Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="Trending Today"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeeAllMovies"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_see_all_pill"
                android:fontFamily="@font/product_sans_bold"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:paddingHorizontal="12dp"
                android:text="See All ›"
                android:textColor="#FF2E3B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeChannels"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp" />

        <!-- 6. Popular Movies Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="Popular Movies"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeeAllSeries"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_see_all_pill"
                android:fontFamily="@font/product_sans_bold"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:paddingHorizontal="12dp"
                android:text="See All ›"
                android:textColor="#FF2E3B"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeSeries"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp" />

    </LinearLayout>
</ScrollView>