<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="6dp"
    app:cardBackgroundColor="#10151D"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivHeroPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- تدرج سفلي ناعم لظهور العنوان والتصنيف بوضوح -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_bottom_fade" />

        <!-- شارة التقييم أعلى اليسار بخط product_sans_bold -->
        <TextView
            android:id="@+id/tvHeroRating"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/bg_search_box_dark"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="★ 7.5"
            android:textColor="#FFC107"
            android:textSize="12sp" />

        <!-- شارة السنة أعلى اليمين بخط product_sans_egular -->
        <TextView
            android:id="@+id/tvHeroYear"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_search_box_dark"
            android:fontFamily="@font/product_sans_egular"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="2026"
            android:textColor="#F1F5F9"
            android:textSize="12sp" />

        <!-- اسم الفيلم في أسفل البطاقة بخط العناوين product_sans_bold -->
        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="18dp"
            android:ellipsize="end"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="Movie Title"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

    </FrameLayout>
</androidx.cardview.widget.CardView>