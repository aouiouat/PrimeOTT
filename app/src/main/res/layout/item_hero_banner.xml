<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="3dp"
    app:cardBackgroundColor="#181B24"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivHeroPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- تدرج علوي ناعم لإبراز التقييم والسنة -->
        <View
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_banner_top_vignette" />

        <!-- تدرج سفلي ناعم لظهور العنوان والتصنيف بوضوح -->
        <View
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_bottom_fade" />

        <!-- شارة التقييم أعلى اليسار بخط product_sans_bold -->
        <TextView
            android:id="@+id/tvHeroRating"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_rating_pill_dark"
            android:drawableStart="@drawable/ic_star_gold"
            android:drawablePadding="5dp"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="7.5"
            android:textColor="#FFC107"
            android:textSize="12sp" />

        <!-- شارة السنة أعلى اليمين بخط product_sans_egular -->
        <TextView
            android:id="@+id/tvHeroYear"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_year_pill_dark"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="2026"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- اسم الفيلم في أسفل البطاقة بخط العناوين product_sans_bold -->
        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:letterSpacing="0.015"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:text="Movie Title"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- الإطار الزجاجي المحيط بالكرت -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_banner_glass_border" />

    </FrameLayout>
</androidx.cardview.widget.CardView>