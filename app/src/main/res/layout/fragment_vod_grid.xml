<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- 1. Top Header: Luxury Title + Order Filter Pill + Search Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvSectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.03"
            android:text="Movies"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Order By Filter Pill (kima image_dd35fc.png) -->
        <LinearLayout
            android:id="@+id/btnOrderFilter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_order_filter_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="11dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_filter_funnel" />

            <TextView
                android:id="@+id/tvOrderFilterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="sans-serif"
                android:text="Order by Popular"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_drop_down" />
        </LinearLayout>

        <!-- Search Button (khas b Movies wella Series bark) -->
        <ImageView
            android:id="@+id/btnVodSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/search_bg"
            android:clickable="true"
            android:focusable="true"
            android:padding="8.5dp"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- 2. Genre Cards Row (All, Action, Adventure, Animation... kima image_dd3621.jpg) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGenreChips"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none" />

    <!-- 3. Grid ta3 Movies/Series (clipToPadding=false + paddingBottom=90dp bach yfout ta7t el Bottom Bar kima Home) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVodGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="90dp"
        android:scrollbars="none" />

</LinearLayout>