<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F0131926"
                android:centerColor="#F50D121C"
                android:endColor="#FA080B12"
                android:type="linear" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1.2dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="28dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="29dp"
                android:topRightRadius="29dp" />
        </shape>
    </item>
</layer-list>