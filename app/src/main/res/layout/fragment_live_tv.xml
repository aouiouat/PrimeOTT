<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/liveTvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <!-- 1. حاوية المشغل بتصميم Reezn الكامل -->
    <FrameLayout
        android:id="@+id/inlinePlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="235dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/inlinePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="never"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- دائرة التحميل البيضاء النقية في الوسط مثل Reezn -->
        <ProgressBar
            android:id="@+id/liveLoadingSpinner"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <!-- طبقة أزرار التحكم (Reezn Player Controls Overlay) -->
        <FrameLayout
            android:id="@+id/inlineControlsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#77000000"
            android:visibility="gone">

            <!-- الشريط العلوي: < Channel Name | 🔒 📺 🎛️ 🗗 [HD] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/btnTopLeftMenu"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="❮"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInlineChannelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="beIN SPORTS 2"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <!-- قفل الشاشة 🔒 -->
                <TextView
                    android:id="@+id/btnLockPlayer"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="🔓"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <!-- مشاركة Watch Together -->
                <TextView
                    android:id="@+id/btnInlineWatchParty"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="📺"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <!-- أيقونة السيرفرات Preferences -->
                <TextView
                    android:id="@+id/btnInlineServers"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="🎛️"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <!-- تكبير/تصغير الشاشة -->
                <TextView
                    android:id="@+id/btnMiniExpand"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="⛶"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- شارة الجودة المؤطرة [HD] مثل أقصى يمين صورة Reezn -->
                <TextView
                    android:id="@+id/btnInlineQualityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_search_box_dark"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="HD"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- أزرار المنتصف الثلاثة مثل Reezn: القناة السابقة |◀  ||  ▶| القناة التالية -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrevChannel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⏮"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnInlinePlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="26dp"
                    android:gravity="center"
                    android:text="⏸"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextChannel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⏭"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- الشريط السفلي المطابق لـ Reezn: شارة [Live] الحمراء + الخط + (Subtitle & Audio | Aspect Ratio | My List) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLiveElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="#E50914"
                        android:gravity="center"
                        android:paddingHorizontal="9dp"
                        android:text="Live"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- خط البث الرمادي الأنيق تحت كلمة Live مباشرة -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="7dp"
                    android:background="#88FFFFFF" />

                <!-- أزرار Reezn الثلاثة أسفل الخط: Subtitle & Audio | Aspect Ratio | My List -->
                <LinearLayout
                    android:id="@+id/fullBottomActionsRow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnInlineAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:gravity="center"
                        android:text="💬  Subtitle &amp; Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnInlineAspect"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:gravity="center"
                        android:text="⛶  Aspect Ratio"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFullPip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:gravity="center"
                        android:text="🔖  My List"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnInlineFullscreen"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⛶"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <View
        android:id="@+id/playerDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#181920" />

    <!-- 2. قوائم الباقات والقنوات: Packages | Channels -->
    <LinearLayout
        android:id="@+id/bottomListsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050507"
        android:orientation="horizontal"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_header_packages" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Packages"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearchPackage"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_search_box_dark"
                android:drawableStart="@drawable/abc_ic_search_api_material"
                android:drawablePadding="6dp"
                android:drawableTint="#7A7F8A"
                android:hint="Search Pack..."
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7F8A"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1A1C23" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_header_channels" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Channels"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSearchChannel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box_dark"
                    android:drawableStart="@drawable/abc_ic_search_api_material"
                    android:drawablePadding="6dp"
                    android:drawableTint="#7A7F8A"
                    android:hint="Search Channel..."
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7A7F8A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnFilterFavorites"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_search_box_dark"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#CBD5E1"
                    android:textSize="18sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>