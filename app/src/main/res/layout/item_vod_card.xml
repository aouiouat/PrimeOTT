<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="124dp"
    android:layout_height="196dp"
    android:layout_marginHorizontal="5.5dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#1B1E26"
    app:cardCornerRadius="15dp"
    app:cardElevation="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- شارة السنة أعلى اليسار -->
        <TextView
            android:id="@+id/tvVodYear"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_year_pill_dark"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="2026"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />

        <!-- التقييم بخط product_sans_bold -->
        <TextView
            android:id="@+id/tvVodMeta"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rating_pill_dark"
            android:drawableStart="@drawable/ic_star_gold"
            android:drawablePadding="3dp"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="7dp"
            android:text="8.5"
            android:textColor="#FFC107"
            android:textSize="10.5sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_bottom_fade" />

        <!-- اسم الفيلم أو المسلسل بخط product_sans_egular -->
        <TextView
            android:id="@+id/tvVodTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:fontFamily="@font/product_sans_bold"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:singleLine="true"
            android:text="Movie Title"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp" />

        <!-- إطار زجاجي رفيع -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_border" />

    </FrameLayout>
</androidx.cardview.widget.CardView>