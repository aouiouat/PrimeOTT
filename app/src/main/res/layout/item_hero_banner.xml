<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="6dp"
    app:cardBackgroundColor="#12131A"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivHeroPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- تدرج أسود سفلي لظهور اسم الفيلم بوضوح كما في الصورة -->
        <View
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:background="#CC08080C" />

        <!-- شارة التقييم أعلى اليسار ★ 7.5 -->
        <TextView
            android:id="@+id/tvHeroRating"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/bg_search_box_dark"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="★ 7.5"
            android:textColor="#FFC107"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- شارة السنة أعلى اليمين 2026 -->
        <TextView
            android:id="@+id/tvHeroYear"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_search_box_dark"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="2026"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- اسم الفيلم في أسفل البطاقة -->
        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="The Mandalorian and Grogu"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </FrameLayout>
</androidx.cardview.widget.CardView>