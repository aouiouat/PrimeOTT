<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B11"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="18dp">

        <!-- الشريط العلوي: تخطي كزائر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTopSkipGuest"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/auth_btn_guest"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Sauter • تصفح كزائر ⬅"
                android:textColor="#D0D7E2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- شعار Royal TV الفخم -->
        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/auth_avatar_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👑"
                android:textSize="36sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvRoyalLogoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.08"
            android:text="ROYAL TV"
            android:textColor="#E50914"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LOGIN — تسجيل الدخول إلى حسابك"
            android:textColor="#9AA5B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- لافتة رسائل النظام والتحقق -->
        <TextView
            android:id="@+id/tvAuthMessageBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/auth_bg_card"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- بطاقة حقول تسجيل الدخول المنظمة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/auth_bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="اسم المستخدم أو البريد الإلكتروني (Username)"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLoginUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/auth_bg_input"
                android:hint="أدخل اسم المستخدم أو البريد..."
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="كلمة المرور (Password)"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/auth_bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="أدخل كلمة المرور..."
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnToggleLoginPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="إظهار 👁️"
                    android:textColor="#80D8FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- تذكرني ونسيت كلمة المرور -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#E50914"
                    android:checked="true"
                    android:text="تذكرني (Remember Me)"
                    android:textColor="#D0D7E2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="نسيت كلمة المرور؟"
                    android:textColor="#80D8FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- زر تسجيل الدخول الأساسي -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/auth_btn_primary"
                android:text="تسجيل الدخول • Login"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- فاصل أو المتابعة عبر -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:text="─── أو المتابعة السريعة عبر ───"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- زر Google الرسمي -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/auth_btn_google"
            android:text="🌐 المتابعة باستخدام حساب Google"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- زر الدخول كزائر -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueAsGuest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/auth_btn_guest"
            android:text="🚀 الدخول بدون حساب • Continue as Guest"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- إنشاء حساب جديد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/auth_bg_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ليس لديك حساب في Royal TV؟ "
                android:textColor="#9AA5B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOpenCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إنشاء حساب جديد • Create Account"
                android:textColor="#E50914"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- الشريط السفلي: الدعم الفني | الخصوصية | الإصدار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvContactSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="📞 الدعم الفني"
                android:textColor="#80D8FF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#475569"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="🛡️ سياسة الخصوصية"
                android:textColor="#80D8FF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#475569"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Royal TV v3.5.0"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>